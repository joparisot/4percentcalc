<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "The 4% Rule Calculator — Backtest Your Retirement Against 100 Years of Market History" %></title>
    <meta name="description" content="<%= content_for(:description) || "Test the 4% retirement rule against every year of real S&P 500 history since 1927. See your portfolio's success rate, worst-case and best-case starting years." %>">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta charset="utf-8">

    <link rel="canonical" href="<%= request.base_url + request.path %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="The 4% Rule Calculator">
    <meta property="og:title" content="<%= content_for(:title) || "The 4% Rule Calculator — Backtest Your Retirement Against 100 Years of Market History" %>">
    <meta property="og:description" content="<%= content_for(:description) || "Test the 4% retirement rule against every year of real S&P 500 history since 1927. See your portfolio's success rate, worst-case and best-case starting years." %>">
    <meta property="og:url" content="<%= request.original_url %>">
    <meta property="og:image" content="<%= request.base_url %>/og.png">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="The 4% Rule Calculator">
    <meta name="twitter:description" content="Test the 4% retirement rule against every year of real S&P 500 history since 1927.">
    <meta name="twitter:image" content="<%= request.base_url %>/og.png">
    <%= yield :head %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <% if ENV["GA_MEASUREMENT_ID"].present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA_MEASUREMENT_ID"] %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= ENV["GA_MEASUREMENT_ID"] %>', { send_page_view: false });

        document.addEventListener('turbo:load', function() {
          gtag('event', 'page_view', {
            page_location: window.location.href,
            page_path: window.location.pathname
          });
        });
      </script>
    <% end %>

    <script src="https://cdn.tailwindcss.com"></script>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>

    <style>
      body {
        font-family: 'Inter', system-ui, sans-serif;
      }
      .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
        width: 8px;
      }
      .custom-scrollbar::-webkit-scrollbar-track {
        background: transparent;
      }
      .custom-scrollbar::-webkit-scrollbar-thumb {
        background-color: #d8d0e7;
        border-radius: 4px;
      }
    </style>
  </head>

  <body class="bg-[#FAFAFA] text-[#1F2937] antialiased min-h-screen flex flex-col">
    <%= yield %>

    <%# Footer %>
    <footer class="mt-auto py-8 bg-white border-t border-gray-200">
      <div class="max-w-6xl mx-auto px-4 text-center text-sm text-[#6B7280] space-y-2">
        <p>Data based on historical S&P 500 returns from Robert Shiller, Yale University. For educational purposes only, not financial advice.</p>
        <p>
          <%= link_to "Methodology", methodology_path, class: "text-[#7C3AED] font-medium hover:underline" %>
          <span class="mx-2 text-gray-300">·</span>
          <%= link_to "Source data", "https://shillerdata.com/", target: "_blank", rel: "noopener noreferrer", class: "text-[#7C3AED] font-medium hover:underline" %>
        </p>
      </div>
    </footer>
  </body>
</html>
