<%# Header %>
<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <div class="flex items-center gap-3">
        <div class="w-8 h-8 rounded-lg bg-[#7C3AED]/10 flex items-center justify-center text-[#7C3AED] text-xl font-bold">
          4%
        </div>
        <h1 class="text-base sm:text-xl font-bold tracking-tight text-[#1F2937] whitespace-nowrap">The 4% Rule Calculator</h1>
      </div>
      <%= link_to methodology_path, class: "flex items-center gap-2 px-4 py-2 rounded-lg bg-[#7C3AED]/10 hover:bg-[#7C3AED]/20 text-[#7C3AED] text-sm font-semibold transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        Methodology
      <% end %>
    </div>
  </div>
</header>

<%# Main Content %>
<main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <%# Tagline %>
  <p class="text-center text-[#374151] text-xl font-medium">What would have happened in the past to people following the 4% rule?</p>

  <%# Intro %>
  <section class="max-w-4xl pb-4">
    <p class="text-lg leading-relaxed text-[#1F2937] pb-2">
      The 4% rule is a retirement guideline popular in the FIRE (Financial Independence, Retire Early) community: withdraw 4% of your portfolio in year one, then adjust that amount for inflation each year. Originally designed to make your money last 30 years.
      <a href="https://en.wikipedia.org/wiki/Trinity_study" target="_blank" rel="noopener noreferrer" class="inline-flex items-center ml-2 px-3 py-1 rounded-full bg-[#7C3AED]/5 hover:bg-[#7C3AED]/10 text-[#7C3AED] text-sm font-semibold transition-all border border-[#7C3AED]/20">
        Learn more
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </p>
  </section>

  <%# Notable Years %>
  <nav aria-labelledby="notable-years-heading" class="max-w-4xl -mt-4 pb-6">
    <h2 id="notable-years-heading" class="text-sm font-semibold uppercase tracking-wider text-[#6B7280] mb-3">Notable years</h2>
    <ul class="flex flex-wrap gap-2">
      <% @notable_years.each do |year, note| %>
        <li>
          <%= link_to year_detail_path(year), class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-gray-200 bg-white hover:border-[#7C3AED]/40 hover:bg-[#EDE9FE] text-sm transition-colors" do %>
            <span class="font-bold text-[#1F2937]"><%= year %></span>
            <span class="text-[#6B7280]"><%= note["label"] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <%= turbo_frame_tag "calculator_results" do %>
    <%# Controls Section %>
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-6" data-controller="calculator">
      <%# Input Card %>
      <div class="lg:col-span-5 flex flex-col gap-6 bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
        <h2 class="text-lg font-bold text-[#1F2937]">Portfolio Parameters</h2>

        <%= form_with url: calculate_path, method: :post, data: { turbo_frame: "calculator_results", calculator_target: "form" } do |f| %>
          <div class="space-y-6">
            <%# Starting Amount Input %>
            <label class="flex flex-col gap-2">
              <span class="text-sm font-medium text-[#6B7280]">Starting Portfolio</span>
              <div class="flex items-center gap-2">
                <button type="button" aria-label="Decrease starting portfolio" data-action="click->calculator#decrementAmount" class="w-12 h-12 rounded-lg border border-gray-300 bg-[#FAFAFA] hover:bg-gray-200 text-[#1F2937] font-bold text-xl transition-colors">−</button>
                <div class="relative flex-1">
                  <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#6B7280] font-medium">$</span>
                  <input type="text"
                      value="<%= number_with_delimiter(@initial_amount) %>"
                      class="w-full h-12 pl-8 pr-4 rounded-lg border border-gray-300 bg-[#FAFAFA] text-[#1F2937] focus:ring-2 focus:ring-[#7C3AED]/20 focus:border-[#7C3AED] font-medium text-lg"
                      data-calculator-target="amountDisplay"
                      data-action="input->calculator#updateAmount" />
                  <%= f.hidden_field :initial_amount, value: @initial_amount, data: { calculator_target: "amountHidden" } %>
                  <%= f.hidden_field :horizon, value: @horizon, id: "horizon_hidden" %>
                </div>
                <button type="button" aria-label="Increase starting portfolio" data-action="click->calculator#incrementAmount" class="w-12 h-12 rounded-lg border border-gray-300 bg-[#FAFAFA] hover:bg-gray-200 text-[#1F2937] font-bold text-xl transition-colors">+</button>
              </div>
            </label>

            <%# Withdrawal Rate Slider %>
            <div class="flex flex-col gap-4">
              <div class="flex justify-between items-end">
                <span class="text-sm font-medium text-[#6B7280]">Annual Withdrawal Rate</span>
                <div class="flex items-center bg-[#FAFAFA] border border-gray-300 rounded-lg px-3 py-1.5">
                  <span class="text-lg font-bold text-[#7C3AED]" data-calculator-target="rateDisplay"><%= @withdrawal_rate %></span>
                  <span class="text-[#6B7280] font-medium ml-1">%</span>
                </div>
              </div>
              <div class="relative w-full">
                <%= f.range_field :withdrawal_rate,
                    value: @withdrawal_rate,
                    min: 1,
                    max: 12,
                    step: 0.5,
                    class: "w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[#7C3AED]",
                    data: { calculator_target: "rate", action: "input->calculator#updateRate" },
                    aria: { label: "Annual withdrawal rate" } %>
              </div>
              <div class="flex justify-between text-xs text-[#6B7280] font-medium">
                <span>1%</span>
                <span>4%</span>
                <span>8%</span>
                <span>12%</span>
              </div>
            </div>
          </div>
        <% end %>

        <button type="button"
                class="w-full h-11 rounded-lg border border-[#7C3AED]/30 bg-[#7C3AED]/5 hover:bg-[#7C3AED]/10 text-[#7C3AED] text-sm font-semibold transition-colors flex items-center justify-center gap-2"
                data-action="click->calculator#copyLink">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
          </svg>
          <span data-calculator-target="shareLabel">Copy link to this scenario</span>
        </button>
      </div>

      <%# Stats Grid %>
      <div class="lg:col-span-7 lg:self-start grid grid-cols-2 sm:grid-cols-4 gap-4">
        <%# Success Rate %>
        <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-[#7C3AED]/30 transition-colors">
          <div class="flex items-start justify-between">
            <p class="text-sm font-medium text-[#6B7280] leading-tight whitespace-nowrap">Success Rate<br><span class="text-xs opacity-75">(30 Years)</span></p>
            <div class="p-1 rounded-md bg-emerald-50 text-emerald-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= @stats&.dig(:success_rate) || 0 %>%</p>
        </div>

        <%# Worst Year %>
        <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-rose-200 transition-colors">
          <div class="flex items-start justify-between">
            <p class="text-sm font-medium text-[#6B7280] leading-tight whitespace-nowrap">Worst Start Year</p>
            <div class="p-1 rounded-md bg-rose-50 text-rose-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
              </svg>
            </div>
          </div>
          <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= @stats&.dig(:worst_year) || "N/A" %></p>
        </div>

        <%# Best Year %>
        <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-emerald-200 transition-colors">
          <div class="flex items-start justify-between">
            <p class="text-sm font-medium text-[#6B7280] leading-tight whitespace-nowrap">Best Start Year</p>
            <div class="p-1 rounded-md bg-emerald-50 text-emerald-500">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
              </svg>
            </div>
          </div>
          <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= @stats&.dig(:best_year) || "N/A" %></p>
        </div>

        <%# Median Final Value %>
        <div class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-[#7C3AED]/30 transition-colors">
          <div class="flex items-start justify-between">
            <p class="text-sm font-medium text-[#6B7280] leading-tight whitespace-nowrap">Median Value<br><span class="text-xs opacity-75">(30 Years)</span></p>
            <div class="p-1 rounded-md bg-[#EDE9FE] text-[#7C3AED]">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
          </div>
          <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= format_currency(@stats&.dig(:median_final_value)) %></p>
        </div>
      </div>
    </section>

    <%# Time Horizon Chart %>
    <section class="w-full bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mt-8"
             data-controller="horizon-chart"
             data-horizon-chart-data-value="<%= @horizon_chart_data.to_json %>"
             data-horizon-chart-initial-amount-value="<%= @initial_amount %>"
             data-horizon-chart-horizon-value="<%= @horizon %>">
      <div class="px-6 py-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-[#1F2937]" data-horizon-chart-target="title">Portfolio Value After <%= @horizon %> Years per Starting Year</h2>
          <p class="text-sm text-[#6B7280] mt-1">Final portfolio value for each historical starting year</p>
        </div>
        <div class="flex items-center gap-2">
          <label for="horizon-select" class="text-sm font-medium text-[#6B7280]">Time Horizon:</label>
          <select id="horizon-select"
                  class="px-3 py-2 rounded-lg border border-gray-300 bg-[#FAFAFA] text-[#1F2937] font-medium text-sm focus:ring-2 focus:ring-[#7C3AED]/20 focus:border-[#7C3AED]"
                  data-horizon-chart-target="dropdown"
                  data-action="change->horizon-chart#changeHorizon">
            <% [10, 20, 30, 40, 50].each do |years| %>
              <option value="<%= years %>" <%= 'selected' if years == @horizon %>><%= years %> years</option>
            <% end %>
          </select>
        </div>
      </div>
      <div class="p-6">
        <div class="h-80">
          <canvas data-horizon-chart-target="canvas"></canvas>
        </div>
      </div>
    </section>

    <%# Heatmap Table %>
    <section id="start-years" class="w-full bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mt-8">
      <div class="px-6 py-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h2 class="text-xl font-bold text-[#1F2937]">Historical Portfolio Health</h2>
          <p class="text-sm text-[#6B7280] mt-1">Portfolio value at each milestone, adjusted for inflation-indexed withdrawals</p>
        </div>
        <div class="flex items-center gap-4 text-xs font-medium">
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-sm bg-[#10B981]"></div>
            <span class="text-[#6B7280]">&gt;100%</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-sm bg-[#34D399]"></div>
            <span class="text-[#6B7280]">50-100%</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-sm bg-[#FBBF24]"></div>
            <span class="text-[#6B7280]">25-50%</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-sm bg-[#F87171]"></div>
            <span class="text-[#6B7280]">1-25%</span>
          </div>
          <div class="flex items-center gap-2">
            <div class="w-3 h-3 rounded-sm bg-[#EF4444]"></div>
            <span class="text-[#6B7280]">Depleted</span>
          </div>
        </div>
      </div>

      <div class="overflow-x-auto custom-scrollbar p-6">
        <table class="w-full min-w-[700px]">
          <thead>
            <tr class="text-xs font-bold uppercase tracking-wider text-[#6B7280]">
              <th class="text-left py-2 px-2 w-24">Start Year</th>
              <th class="text-center py-2 px-2">Year 10</th>
              <th class="text-center py-2 px-2">Year 20</th>
              <th class="text-center py-2 px-2">Year 30</th>
              <th class="text-center py-2 px-2">Year 40</th>
              <th class="text-center py-2 px-2">Year 50</th>
              <th class="w-10"></th>
            </tr>
          </thead>
          <tbody>
            <% @results.each do |result| %>
              <% detail_url = year_detail_path(result[:starting_year], initial_amount: @initial_amount, withdrawal_rate: @withdrawal_rate) %>
              <tr class="group border-b border-dashed border-gray-200 last:border-0 hover:bg-[#EDE9FE] cursor-pointer transition-colors"
                  onclick="window.location='<%= detail_url %>'">
                <td class="py-3 px-2 font-semibold">
                  <%= link_to result[:starting_year], detail_url, class: "text-[#1F2937] group-hover:text-[#7C3AED] transition-colors" %>
                </td>
                <% [10, 20, 30, 40, 50].each do |milestone| %>
                  <td class="py-3 px-2 text-center">
                    <% value = result[:milestones][milestone] %>
                    <% if value.nil? %>
                      <span class="inline-block px-3 py-2 rounded-md bg-gray-100 text-gray-400 text-sm font-medium">N/A</span>
                    <% elsif value == 0 || (result[:depleted_at] && result[:depleted_at] <= milestone) %>
                      <span class="inline-block px-3 py-2 rounded-md bg-[#EF4444] text-white text-sm font-bold">$0</span>
                    <% else %>
                      <% pct = (value.to_f / @initial_amount * 100) %>
                      <% bg_color = if pct > 100
                                      "bg-[#10B981] text-white"
                                    elsif pct > 50
                                      "bg-[#34D399] text-white"
                                    elsif pct > 25
                                      "bg-[#FBBF24] text-gray-900"
                                    else
                                      "bg-[#F87171] text-white"
                                    end %>
                      <span class="inline-block px-3 py-2 rounded-md <%= bg_color %> text-sm font-medium">
                        <%= format_currency(value) %>
                      </span>
                    <% end %>
                  </td>
                <% end %>
                <td class="py-3 px-2 text-center">
                  <svg class="w-4 h-4 inline-block text-gray-300 group-hover:text-[#7C3AED] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                  </svg>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>
</main>

