<% @faq_items = homepage_faq_items(@faq) %>
<% content_for :head, json_ld_tag(faq_structured_data(@faq_items)) %>
<%# Header %>
<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 h-16">
      <div class="flex items-center gap-3">
        <%= render "calculator/logo_mark" %>
        <h1 class="text-base sm:text-xl font-bold tracking-tight text-[#1F2937] whitespace-nowrap">The 4% Rule Calculator</h1>
      </div>
      <%= link_to methodology_path, class: "shrink-0 flex items-center gap-2 px-3 sm:px-4 py-2 rounded-lg bg-[#7C3AED]/10 hover:bg-[#7C3AED]/20 text-[#7C3AED] text-sm font-semibold transition-colors" do %>
        <svg class="hidden sm:block w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path>
        </svg>
        Methodology
      <% end %>
    </div>
  </div>
</header>

<%# Main Content %>
<main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <%# Tagline %>
  <p class="text-center text-[#374151] text-xl font-medium">See how much you need to retire, and whether it would have lasted in every market since <%= @faq[:first_year] %>.</p>

  <%# Intro %>
  <section class="max-w-4xl pb-4">
    <p class="text-lg leading-relaxed text-[#1F2937] pb-2">
      The 4% rule is a retirement guideline popular in the FIRE (Financial Independence, Retire Early) community: withdraw 4% of your portfolio in year one, then adjust that amount for inflation each year. Originally designed to make your money last 30 years.
      <a href="https://en.wikipedia.org/wiki/Trinity_study" target="_blank" rel="noopener noreferrer" class="inline-flex items-center ml-2 px-3 py-1 rounded-full bg-[#7C3AED]/5 hover:bg-[#7C3AED]/10 text-[#7C3AED] text-sm font-semibold transition-all border border-[#7C3AED]/20">
        Learn more
        <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
        </svg>
      </a>
    </p>
  </section>

  <%# Notable Years %>
  <nav aria-labelledby="notable-years-heading" class="max-w-4xl -mt-4 pb-6">
    <h2 id="notable-years-heading" class="text-sm font-semibold uppercase tracking-wider text-[#6B7280] mb-3">Notable years</h2>
    <ul class="flex flex-wrap gap-2">
      <% @notable_years.each do |year, note| %>
        <li>
          <%= link_to year_detail_path(year), class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-gray-200 bg-white hover:border-[#7C3AED]/40 hover:bg-[#EDE9FE] text-sm transition-colors" do %>
            <span class="font-bold text-[#1F2937]"><%= year %></span>
            <span class="text-[#6B7280]"><%= note["label"] %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <%= turbo_frame_tag "calculator_results" do %>
    <%= render "calculator" %>
  <% end %>

  <%= render "faq", items: @faq_items %>
</main>

