<%# Controls Section %>
<section class="grid grid-cols-1 lg:grid-cols-12 gap-6" data-controller="calculator">
  <%# Input Card %>
  <div class="lg:col-span-5 flex flex-col gap-6 bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
    <h2 class="text-lg font-bold text-[#1F2937]">Portfolio Parameters</h2>

    <%= form_with url: calculate_path, method: :post, data: { turbo_frame: "calculator_results", calculator_target: "form" } do |f| %>
      <%= f.hidden_field :horizon, value: @horizon, id: "horizon_hidden" %>
      <%= f.hidden_field :stock_allocation, value: @comparison_allocation, id: "stock_allocation_hidden" %>
      <div class="space-y-6">

        <%# Input Mode Toggle %>
        <fieldset>
          <legend class="sr-only">Calculate from</legend>
          <div class="grid grid-cols-2 gap-1 p-1 rounded-lg bg-gray-100">
            <% [["portfolio", "I know my portfolio"], ["spending", "I know my spending"]].each do |value, label| %>
              <label class="cursor-pointer">
                <%= f.radio_button :mode, value, checked: @mode == value, class: "sr-only peer", data: { action: "change->calculator#changeMode" } %>
                <span class="block text-center px-3 py-2 rounded-md text-sm font-semibold text-[#6B7280] hover:text-[#1F2937] transition-colors peer-checked:bg-white peer-checked:text-[#7C3AED] peer-checked:shadow-sm peer-focus-visible:ring-2 peer-focus-visible:ring-[#7C3AED]/40"><%= label %></span>
              </label>
            <% end %>
          </div>
        </fieldset>

        <% if @mode == "spending" %>
          <%# Annual Spending Input %>
          <label class="flex flex-col gap-2">
            <span class="text-sm font-medium text-[#6B7280]">Annual Spending</span>
            <div class="flex items-center gap-2">
              <button type="button" aria-label="Decrease annual spending" data-action="click->calculator#decrementSpending" class="w-12 h-12 rounded-lg border border-gray-300 bg-[#FAFAFA] hover:bg-gray-200 text-[#1F2937] font-bold text-xl transition-colors">−</button>
              <div class="relative flex-1">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#6B7280] font-medium">$</span>
                <input type="text"
                    inputmode="numeric"
                    value="<%= number_with_delimiter(@annual_spending) %>"
                    class="w-full h-12 pl-8 pr-4 rounded-lg border border-gray-300 bg-[#FAFAFA] text-[#1F2937] focus:ring-2 focus:ring-[#7C3AED]/20 focus:border-[#7C3AED] font-medium text-lg"
                    data-calculator-target="spendingDisplay"
                    data-action="input->calculator#updateSpending" />
                <%= f.hidden_field :annual_spending, value: @annual_spending, data: { calculator_target: "spendingHidden" } %>
                <%= f.hidden_field :initial_amount, value: @initial_amount %>
              </div>
              <button type="button" aria-label="Increase annual spending" data-action="click->calculator#incrementSpending" class="w-12 h-12 rounded-lg border border-gray-300 bg-[#FAFAFA] hover:bg-gray-200 text-[#1F2937] font-bold text-xl transition-colors">+</button>
            </div>
          </label>

          <%# Required Portfolio %>
          <p class="rounded-lg bg-[#EDE9FE] border border-[#7C3AED]/20 px-4 py-3 text-[#1F2937]" aria-live="polite">
            You need
            <strong class="text-2xl font-bold text-[#7C3AED]" data-calculator-target="requiredAmount"><%= number_to_currency(@initial_amount, precision: 0) %></strong>
            to withdraw <strong data-calculator-target="requiredSpending"><%= number_to_currency(@annual_spending, precision: 0) %></strong>/yr
            at <strong><span data-calculator-target="requiredRate"><%= format_rate(@withdrawal_rate) %></span>%</strong>.
          </p>
        <% else %>
          <%# Starting Amount Input %>
          <label class="flex flex-col gap-2">
            <span class="text-sm font-medium text-[#6B7280]">Starting Portfolio</span>
            <div class="flex items-center gap-2">
              <button type="button" aria-label="Decrease starting portfolio" data-action="click->calculator#decrementAmount" class="w-12 h-12 rounded-lg border border-gray-300 bg-[#FAFAFA] hover:bg-gray-200 text-[#1F2937] font-bold text-xl transition-colors">−</button>
              <div class="relative flex-1">
                <span class="absolute left-4 top-1/2 -translate-y-1/2 text-[#6B7280] font-medium">$</span>
                <input type="text"
                    value="<%= number_with_delimiter(@initial_amount) %>"
                    class="w-full h-12 pl-8 pr-4 rounded-lg border border-gray-300 bg-[#FAFAFA] text-[#1F2937] focus:ring-2 focus:ring-[#7C3AED]/20 focus:border-[#7C3AED] font-medium text-lg"
                    data-calculator-target="amountDisplay"
                    data-action="input->calculator#updateAmount" />
                <%= f.hidden_field :initial_amount, value: @initial_amount, data: { calculator_target: "amountHidden" } %>
              </div>
              <button type="button" aria-label="Increase starting portfolio" data-action="click->calculator#incrementAmount" class="w-12 h-12 rounded-lg border border-gray-300 bg-[#FAFAFA] hover:bg-gray-200 text-[#1F2937] font-bold text-xl transition-colors">+</button>
            </div>
          </label>
          <%= f.hidden_field :annual_spending, value: @annual_spending %>
        <% end %>

        <%# Withdrawal Rate Slider %>
        <div class="flex flex-col gap-4">
          <div class="flex justify-between items-end">
            <span class="text-sm font-medium text-[#6B7280]">Annual Withdrawal Rate</span>
            <div class="flex items-center bg-[#FAFAFA] border border-gray-300 rounded-lg px-3 py-1.5">
              <span class="text-lg font-bold text-[#7C3AED]" data-calculator-target="rateDisplay"><%= @withdrawal_rate %></span>
              <span class="text-[#6B7280] font-medium ml-1">%</span>
            </div>
          </div>
          <% rate_min, rate_max = 1, 12 %>
          <div class="relative w-full">
            <%= f.range_field :withdrawal_rate,
                value: @withdrawal_rate,
                min: rate_min,
                max: rate_max,
                step: 0.5,
                class: "w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-[#7C3AED]",
                data: { calculator_target: "rate", action: "input->calculator#updateRate" },
                aria: { label: "Annual withdrawal rate" } %>
          </div>
          <%# Middle labels sit under the thumb centre: the 16px thumb travels from 8px to (100% - 8px). %>
          <div class="relative h-4 text-xs text-[#6B7280] font-medium" data-rate-ticks>
            <% [rate_min, 4, 8, rate_max].each do |rate| %>
              <% if rate == rate_min %>
                <span class="absolute left-0" data-rate-tick="<%= rate %>"><%= rate %>%</span>
              <% elsif rate == rate_max %>
                <span class="absolute right-0" data-rate-tick="<%= rate %>"><%= rate %>%</span>
              <% else %>
                <span class="absolute -translate-x-1/2" style="left: calc(8px + (100% - 16px) * <%= (rate - rate_min).fdiv(rate_max - rate_min).round(4) %>)" data-rate-tick="<%= rate %>"><%= rate %>%</span>
              <% end %>
            <% end %>
          </div>
        </div>

        <%# Annual Fee %>
        <div class="flex items-center justify-between gap-4">
          <label for="fee-select" class="text-sm font-medium text-[#6B7280]">Annual Fees <span class="block text-xs opacity-75">Fund expense ratio + advisor fee</span></label>
          <div class="relative shrink-0">
            <%= f.select :fee, fee_options(@fee), {}, id: "fee-select", class: "appearance-none pl-3 pr-9 py-2 rounded-lg border border-gray-300 bg-[#FAFAFA] text-[#1F2937] font-medium text-sm cursor-pointer hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-[#7C3AED]/20 focus:border-[#7C3AED]", data: { action: "change->calculator#submit" } %>
            <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
            </svg>
          </div>
        </div>
      </div>
    <% end %>

    <button type="button"
            class="w-full h-11 rounded-lg border border-[#7C3AED]/30 bg-[#7C3AED]/5 hover:bg-[#7C3AED]/10 text-[#7C3AED] text-sm font-semibold transition-colors flex items-center justify-center gap-2"
            data-action="click->calculator#copyLink">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path>
      </svg>
      <span data-calculator-target="shareLabel">Copy link to this scenario</span>
    </button>
  </div>

  <%# Stats Grid %>
  <div class="lg:col-span-7 lg:self-start grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-2 gap-4">
    <%# Success Rate %>
    <div data-stat-card class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-[#7C3AED]/30 transition-colors">
      <div class="flex items-start justify-between gap-2">
        <p data-stat-card-label class="min-w-0 text-sm font-medium text-[#6B7280] leading-tight">Success Rate<br><span class="text-xs opacity-75">(30 Years)</span></p>
        <div data-stat-card-icon class="shrink-0 p-1 rounded-md bg-emerald-50 text-emerald-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= @stats&.dig(:success_rate) || 0 %>%</p>
    </div>

    <%# Worst Year %>
    <div data-stat-card class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-rose-200 transition-colors">
      <div class="flex items-start justify-between gap-2">
        <p data-stat-card-label class="min-w-0 text-sm font-medium text-[#6B7280] leading-tight">Worst Start Year</p>
        <div data-stat-card-icon class="shrink-0 p-1 rounded-md bg-rose-50 text-rose-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 17h8m0 0V9m0 8l-8-8-4 4-6-6"></path>
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= @stats&.dig(:worst_year) || "N/A" %></p>
    </div>

    <%# Best Year %>
    <div data-stat-card class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-emerald-200 transition-colors">
      <div class="flex items-start justify-between gap-2">
        <p data-stat-card-label class="min-w-0 text-sm font-medium text-[#6B7280] leading-tight">Best Start Year</p>
        <div data-stat-card-icon class="shrink-0 p-1 rounded-md bg-emerald-50 text-emerald-500">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= @stats&.dig(:best_year) || "N/A" %></p>
    </div>

    <%# Median Final Value %>
    <div data-stat-card class="bg-white rounded-xl border border-gray-200 p-5 shadow-sm flex flex-col justify-between hover:border-[#7C3AED]/30 transition-colors">
      <div class="flex items-start justify-between gap-2">
        <p data-stat-card-label class="min-w-0 text-sm font-medium text-[#6B7280] leading-tight">Median Value<br><span class="text-xs opacity-75">(30 Years)</span></p>
        <div data-stat-card-icon class="shrink-0 p-1 rounded-md bg-[#EDE9FE] text-[#7C3AED]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
      </div>
      <p class="text-3xl font-bold text-[#1F2937] mt-4"><%= format_currency(@stats&.dig(:median_final_value)) %></p>
    </div>
  </div>
</section>

<%= render "calculator/allocation_comparison" %>

<%# Time Horizon Chart %>
<section class="w-full bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mt-8"
         data-controller="horizon-chart"
         data-horizon-chart-data-value="<%= @horizon_chart_data.to_json %>"
         data-horizon-chart-events-value="<%= MarketEvents.all.to_json %>"
         data-horizon-chart-initial-amount-value="<%= @initial_amount %>"
         data-horizon-chart-horizon-value="<%= @horizon %>"
         data-horizon-chart-comparison-value="<%= @comparison_horizon_chart_data.to_json %>"
         data-horizon-chart-comparison-label-value="<%= Calculator.allocation_label(@comparison_allocation) %>">
  <div class="px-6 py-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-[#1F2937]" data-horizon-chart-target="title">Portfolio Value After <%= @horizon %> Years per Starting Year</h2>
      <p class="text-sm text-[#6B7280] mt-1">Final portfolio value for each historical starting year: 100% S&amp;P 500 vs. <%= Calculator.allocation_label(@comparison_allocation) %></p>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      <div class="inline-flex rounded-lg border border-gray-300 bg-[#FAFAFA] p-0.5 text-sm font-medium" role="group" aria-label="Y-axis scale">
        <% [["linear", "Linear"], ["logarithmic", "Log"]].each do |scale, label| %>
          <button type="button"
                  class="px-3 py-1.5 rounded-md text-[#6B7280] hover:text-[#1F2937] aria-pressed:bg-white aria-pressed:text-[#7C3AED] aria-pressed:shadow-sm transition-colors"
                  aria-pressed="false"
                  data-scale="<%= scale %>"
                  data-horizon-chart-target="scaleButton"
                  data-action="horizon-chart#setScale"><%= label %></button>
        <% end %>
      </div>
      <div class="flex items-center gap-2">
      <label for="horizon-select" class="text-sm font-medium text-[#6B7280]">Time Horizon:</label>
      <div class="relative">
        <select id="horizon-select"
                class="appearance-none pl-3 pr-9 py-2 rounded-lg border border-gray-300 bg-[#FAFAFA] text-[#1F2937] font-medium text-sm cursor-pointer hover:border-gray-400 focus:outline-none focus:ring-2 focus:ring-[#7C3AED]/20 focus:border-[#7C3AED]"
                data-horizon-chart-target="dropdown"
                data-action="change->horizon-chart#changeHorizon">
          <% [10, 20, 30, 40, 50].each do |years| %>
            <option value="<%= years %>" <%= 'selected' if years == @horizon %>><%= years %> years</option>
          <% end %>
        </select>
        <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-[#6B7280]" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
        </svg>
      </div>
      </div>
    </div>
  </div>
  <div class="p-6">
    <div class="h-80">
      <canvas data-horizon-chart-target="canvas"></canvas>
    </div>
    <div class="mt-4 flex flex-wrap justify-center gap-x-5 gap-y-2 text-xs font-medium text-[#6B7280]" data-horizon-legend>
      <span class="font-semibold text-[#1F2937] whitespace-nowrap">100% S&amp;P 500 line:</span>
      <% [["#EF4444", "Below the starting amount"], ["#F59E0B", "1–4× the starting amount"], ["#10B981", "More than 4× the starting amount"]].each do |color, label| %>
        <span class="flex items-center gap-1.5 whitespace-nowrap"><span class="w-4 h-1 rounded-full" style="background-color: <%= color %>"></span><%= label %></span>
      <% end %>
      <span class="flex items-center gap-1.5 whitespace-nowrap" data-comparison-legend><span class="w-4 h-0.5 rounded-full bg-[#2563EB]"></span><%= Calculator.allocation_label(@comparison_allocation) %> (Trinity study mix)</span>
      <span class="flex items-center gap-1.5 whitespace-nowrap"><span class="h-3 border-l border-dashed border-[#6B7280]"></span>Major market event</span>
      <span class="flex items-center gap-1.5 whitespace-nowrap"><span class="w-4 border-t-2 border-dashed border-[#9CA3AF]"></span>Starting amount (<%= number_to_currency(@initial_amount, precision: 0) %>)</span>
    </div>
    <p class="hidden mt-3 text-xs text-[#6B7280]" data-horizon-chart-target="scaleNote">Log scale: each labelled line is 10× the one below, so big and small outcomes stay readable. Start years that ran out of money sit on the bottom line.</p>
  </div>
</section>

<%# Heatmap Table %>
<section id="start-years" class="w-full bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden mt-8">
  <div class="px-6 py-5 border-b border-gray-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <h2 class="text-xl font-bold text-[#1F2937]">Historical Portfolio Health</h2>
      <p class="text-sm text-[#6B7280] mt-1">100% S&amp;P 500 portfolio value at each milestone, adjusted for inflation-indexed withdrawals</p>
    </div>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs font-medium whitespace-nowrap" data-heatmap-legend>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-sm bg-[#10B981]"></div>
        <span class="text-[#6B7280]">&gt;100%</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-sm bg-[#34D399]"></div>
        <span class="text-[#6B7280]">50-100%</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-sm bg-[#FBBF24]"></div>
        <span class="text-[#6B7280]">25-50%</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-sm bg-[#F87171]"></div>
        <span class="text-[#6B7280]">1-25%</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-3 h-3 rounded-sm bg-[#EF4444]"></div>
        <span class="text-[#6B7280]">Depleted</span>
      </div>
    </div>
  </div>

  <div class="overflow-x-auto custom-scrollbar p-6">
    <table class="w-full min-w-[700px]">
      <thead>
        <tr class="text-xs font-bold uppercase tracking-wider text-[#6B7280]">
          <th class="text-left py-2 px-2 w-24">Start Year</th>
          <th class="text-center py-2 px-2">Year 10</th>
          <th class="text-center py-2 px-2">Year 20</th>
          <th class="text-center py-2 px-2">Year 30</th>
          <th class="text-center py-2 px-2">Year 40</th>
          <th class="text-center py-2 px-2">Year 50</th>
          <th class="w-10"></th>
        </tr>
      </thead>
      <tbody>
        <% @results.each do |result| %>
          <% detail_url = year_detail_path(result[:starting_year], year_detail_scenario_params(initial_amount: @initial_amount, withdrawal_rate: @withdrawal_rate, fee: @fee, stock_allocation: (@comparison_allocation unless @comparison_allocation == Calculator::DEFAULT_COMPARISON_ALLOCATION))) %>
          <tr class="group border-b border-dashed border-gray-200 last:border-0 hover:bg-[#EDE9FE] cursor-pointer transition-colors"
              onclick="window.location='<%= detail_url %>'">
            <td class="py-3 px-2 font-semibold">
              <%= link_to result[:starting_year], detail_url, class: "text-[#1F2937] group-hover:text-[#7C3AED] transition-colors" %>
            </td>
            <% [10, 20, 30, 40, 50].each do |milestone| %>
              <td class="py-3 px-2 text-center">
                <% value = result[:milestones][milestone] %>
                <% if value.nil? %>
                  <span class="inline-block px-3 py-2 rounded-md bg-gray-100 text-gray-400 text-sm font-medium">N/A</span>
                <% elsif value == 0 || (result[:depleted_at] && result[:depleted_at] <= milestone) %>
                  <span class="inline-block px-3 py-2 rounded-md bg-[#EF4444] text-white text-sm font-bold">$0</span>
                <% else %>
                  <% pct = (value.to_f / @initial_amount * 100) %>
                  <% bg_color = if pct > 100
                                  "bg-[#10B981] text-white"
                                elsif pct > 50
                                  "bg-[#34D399] text-white"
                                elsif pct > 25
                                  "bg-[#FBBF24] text-gray-900"
                                else
                                  "bg-[#F87171] text-white"
                                end %>
                  <span class="inline-block px-3 py-2 rounded-md <%= bg_color %> text-sm font-medium">
                    <%= format_currency(value) %>
                  </span>
                <% end %>
              </td>
            <% end %>
            <td class="py-3 px-2 text-center">
              <svg class="w-4 h-4 inline-block text-gray-300 group-hover:text-[#7C3AED] group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
