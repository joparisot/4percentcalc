<section aria-labelledby="faq-heading" class="w-full bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
  <div class="px-6 py-5 border-b border-gray-200">
    <h2 id="faq-heading" class="text-xl font-bold text-[#1F2937]">Frequently Asked Questions</h2>
  </div>
  <div class="divide-y divide-gray-200">
    <% items.each do |item| %>
      <details class="group px-6 py-4">
        <summary class="flex items-center justify-between gap-4 cursor-pointer list-none font-semibold text-[#1F2937] hover:text-[#7C3AED] transition-colors [&::-webkit-details-marker]:hidden">
          <h3><%= item[:question] %></h3>
          <svg class="w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </summary>
        <p class="mt-3 text-[#374151] leading-relaxed"><%= item[:answer] %></p>
      </details>
    <% end %>
  </div>
</section>
