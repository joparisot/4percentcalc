<% content_for :title, "Methodology — The 4% Rule Calculator" %>
<% content_for :description, "How the 4% rule backtest works: data sources, withdrawal assumptions, and how each historical starting year is scored." %>

<%# Header %>
<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 h-16">
      <div class="flex items-center gap-3 min-w-0">
        <%= render "calculator/logo_mark" %>
        <%= link_to root_path, class: "hidden sm:inline text-xl font-bold tracking-tight text-[#1F2937] hover:text-[#7C3AED] transition-colors" do %>
          The 4% Rule Calculator
        <% end %>
      </div>
      <nav class="shrink-0 flex items-center gap-4 sm:gap-6">
        <%= link_to "Calculator", root_path, class: "text-sm font-medium text-[#6B7280] hover:text-[#7C3AED] transition-colors" %>
        <span class="text-sm font-bold text-[#7C3AED]">Methodology</span>
      </nav>
    </div>
  </div>
</header>

<%# Main Content %>
<main class="flex-grow w-full max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
  <%# Page Heading %>
  <section class="mb-12">
    <h1 class="text-4xl md:text-5xl font-black leading-tight tracking-tight text-[#1F2937]">
      Methodology
    </h1>
    <p class="text-lg md:text-xl text-[#6B7280] mt-4 max-w-2xl">
      Here is exactly how the calculator works
    </p>
  </section>

  <hr class="border-gray-200 mb-12">

  <%# How It Works Section %>
  <section class="mb-12">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-[#7C3AED]/10 p-2 rounded-lg text-[#7C3AED]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-[#1F2937]">How It Works</h2>
    </div>

    <div class="text-[#6B7280] space-y-4">
      <p>
        The calculator uses the "Classic 4% Rule" from William Bengen's 1994 research.
      </p>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Year 1:</strong> Withdraw 4% of your initial portfolio</li>
        <li><strong>Year 2+:</strong> Increase that dollar amount by each year's inflation</li>
        <li>Withdrawals are annual (beginning of each year)</li>
        <li>Remaining portfolio grows/shrinks with S&P 500 returns</li>
        <li>For comparison, the same withdrawals are also run on the <a href="https://en.wikipedia.org/wiki/Trinity_study" target="_blank" rel="noopener noreferrer" class="text-[#7C3AED] font-medium hover:underline">Trinity study</a>'s stock/bond mixes (75/25, 50/50, 25/75, 0/100), rebalanced to the target mix every year</li>
      </ul>
    </div>

    <%# Example Callout %>
    <div class="mt-6 rounded-xl bg-[#7C3AED]/5 border border-[#7C3AED]/10 p-6">
      <div class="flex items-center gap-2 mb-3">
        <svg class="w-5 h-5 text-[#7C3AED]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
        </svg>
        <h3 class="text-lg font-bold text-[#1F2937]">Example</h3>
      </div>
      <p class="text-[#1F2937] font-medium">
        $1M portfolio &rarr; $40k Year 1 &rarr; if 3% inflation &rarr; $41,200 Year 2
      </p>
    </div>
  </section>

  <%# Data Sources Section %>
  <section class="mb-12">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-[#7C3AED]/10 p-2 rounded-lg text-[#7C3AED]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4"></path>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-[#1F2937]">Data Sources</h2>
    </div>

    <div class="p-6 rounded-xl border border-gray-200 bg-white shadow-sm">
      <p class="text-[#6B7280] mb-4">
        <strong class="text-[#1F2937]">S&P 500 returns & CPI inflation:</strong> Robert Shiller, Yale University
      </p>
      <p class="text-sm text-[#6B7280] mb-4">
        Includes monthly S&P 500 prices, dividends, and CPI from 1871&ndash;present. We use annual returns (January to January).
      </p>
      <p class="text-[#6B7280] mb-4">
        <strong class="text-[#1F2937]">Bond returns:</strong> the same dataset's monthly total returns on 10-year U.S. Treasuries (GS10), compounded January to January. The original Trinity study used long-term high-grade corporate bonds, so its success rates differ slightly.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="https://shillerdata.com/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#7C3AED] font-bold hover:underline">
          Shiller Data Website
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
          </svg>
        </a>
        <a href="https://img1.wsimg.com/blobby/go/e5e77e0b-59d1-44d9-ab25-4763ac982e53/downloads/ie_data.xls" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 text-[#7C3AED] font-bold hover:underline">
          Download Dataset (ie_data.xls)
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <%# Assumptions Section %>
  <section id="fees-and-taxes" class="mb-12">
    <h2 class="text-2xl font-bold text-[#1F2937] mb-4">Fees and Taxes</h2>
    <div class="space-y-4 text-[#374151] leading-relaxed">
      <p><strong>Fees.</strong> Results assume no fees unless you pick an annual fee under Portfolio Parameters. The fee is charged on the portfolio at the end of each year, like a fund's expense ratio or an advisor's fee. It matters more than it looks: with $1M at 4% over 30 years, the historical success rate is <%= @fee_example[0] %>% with no fees and <%= @fee_example[1] %>% with a 1% annual fee.</p>
      <p><strong>Taxes.</strong> Results are before taxes, because what you owe depends on which account the money comes from:</p>
      <ul class="list-disc pl-6 space-y-2">
        <li><strong>Taxable brokerage account:</strong> only the gain is taxed. Selling shares gives you back your cost basis tax-free, and the profit is taxed as a capital gain (0%, 15% or 20% federally for shares held over a year). Dividends are taxed every year, even when reinvested.</li>
        <li><strong>Traditional 401(k) or IRA:</strong> every dollar withdrawn is taxed as ordinary income.</li>
        <li><strong>Roth 401(k) or IRA:</strong> qualified withdrawals are tax-free.</li>
      </ul>
      <p>The simplest way to account for taxes is to treat the withdrawal as your <em>pre-tax</em> budget. If you need $40,000 a year after tax and expect to pay about 10% in tax, plan to withdraw about $44,400 a year. This is general information, not tax advice.</p>
    </div>
  </section>

  <section class="mb-12">
    <div class="flex items-center gap-3 mb-6">
      <div class="bg-[#7C3AED]/10 p-2 rounded-lg text-[#7C3AED]">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h2 class="text-2xl font-bold text-[#1F2937]">Assumptions</h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-5 rounded-lg bg-gray-50 border border-gray-100">
        <div class="flex gap-3">
          <svg class="w-5 h-5 text-[#7C3AED] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"></path>
          </svg>
          <div>
            <h4 class="font-bold text-[#1F2937] text-sm mb-1">100% S&P 500, Plus Stock/Bond Mixes</h4>
            <p class="text-sm text-[#6B7280]">
              The main results put all money in the S&P 500. The stock/bond comparison holds the rest in 10-year Treasuries and rebalances annually.
            </p>
          </div>
        </div>
      </div>

      <div class="p-5 rounded-lg bg-gray-50 border border-gray-100">
        <div class="flex gap-3">
          <svg class="w-5 h-5 text-[#7C3AED] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <div>
            <h4 class="font-bold text-[#1F2937] text-sm mb-1">Before Taxes, Fees Optional</h4>
            <p class="text-sm text-[#6B7280]">
              Results are before taxes. Fees are zero unless you pick an annual fee in the calculator. See <a href="#fees-and-taxes" class="text-[#7C3AED] hover:underline">Fees and Taxes</a>.
            </p>
          </div>
        </div>
      </div>

      <div class="p-5 rounded-lg bg-gray-50 border border-gray-100">
        <div class="flex gap-3">
          <svg class="w-5 h-5 text-[#7C3AED] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <div>
            <h4 class="font-bold text-[#1F2937] text-sm mb-1">Annual Withdrawals</h4>
            <p class="text-sm text-[#6B7280]">
              Taken at the beginning of each year.
            </p>
          </div>
        </div>
      </div>

      <div class="p-5 rounded-lg bg-gray-50 border border-gray-100">
        <div class="flex gap-3">
          <svg class="w-5 h-5 text-[#7C3AED] mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"></path>
          </svg>
          <div>
            <h4 class="font-bold text-[#1F2937] text-sm mb-1">Dividends Reinvested</h4>
            <p class="text-sm text-[#6B7280]">
              Returns include dividend reinvestment.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

