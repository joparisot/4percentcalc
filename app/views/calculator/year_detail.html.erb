<% content_for :title, @summary.title %>
<% content_for :description, @summary.description %>
<% content_for :head do %>
  <% year_detail_structured_data(@summary).each do |data| %>
    <%= json_ld_tag(data) %>
  <% end %>
<% end %>

<%# Header %>
<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-gray-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between gap-3 h-16">
      <%= link_to root_path(year_detail_scenario_params(initial_amount: @initial_amount, withdrawal_rate: @withdrawal_rate, fee: @fee, scenario: (@comparison unless @comparison == Scenario.default_comparison))), class: "shrink-0 flex items-center gap-2 px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-[#1F2937] text-sm font-semibold transition-colors" do %>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
        </svg>
        <span><span class="hidden sm:inline">Back to </span>Calculator</span>
      <% end %>
      <div class="flex items-center gap-3">
        <%= render "calculator/logo_mark" %>
        <p class="hidden sm:block text-xl font-bold tracking-tight text-[#1F2937]">The 4% Rule Calculator</p>
      </div>
    </div>
  </div>
</header>

<%# Main Content %>
<main class="flex-grow w-full max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <section class="max-w-4xl">
    <h1 class="text-3xl font-bold tracking-tight text-[#1F2937]"><%= @summary.headline %></h1>
    <p class="mt-3 text-lg leading-relaxed text-[#374151]"><%= @summary.sentences.join(" ") %></p>
    <% if (start_cape = @calculator.cape(@starting_year)) %>
      <%= link_to valuations_path, class: "mt-4 inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-gray-200 bg-white hover:border-[#7C3AED]/40 hover:bg-[#EDE9FE] text-sm transition-colors" do %>
        <span class="font-bold text-[#1F2937]">CAPE at start: <%= number_with_precision(start_cape, precision: 1) %></span>
        <span class="text-[#6B7280]">&middot; higher than <%= @valuations.percentile(start_cape) %>% of start years</span>
      <% end %>
    <% end %>
  </section>

  <section class="bg-white rounded-xl border border-gray-200 shadow-sm p-6" data-controller="chart" data-chart-data-value="<%= @chart_data.to_json %>" data-chart-comparison-value="<%= @comparison_chart_data.to_json %>" data-chart-comparison-label-value="<%= @comparison.label %>" data-chart-comparison-color-value="<%= @comparison.color %>" data-chart-events-value="<%= MarketEvents.all.to_json %>" data-chart-starting-year-value="<%= @starting_year %>">
    <h2 class="text-2xl font-bold text-[#1F2937] mb-6">Portfolio Value: Started in <%= @starting_year %></h2>

    <div class="flex flex-wrap justify-between items-center gap-x-4 gap-y-2 mb-4">
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-year-chart-legend>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-[#7C3AED]"></div>
          <span class="text-sm text-[#6B7280] whitespace-nowrap">100% S&amp;P 500</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full" style="background-color: <%= @comparison.color %>"></div>
          <span class="text-sm text-[#6B7280] whitespace-nowrap"><%= @comparison.label %> (<%= @comparison.trinity? ? "Trinity study mix" : "since 1972" %>)</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="h-3 border-l border-dashed border-[#6B7280]"></div>
          <span class="text-sm text-[#6B7280] whitespace-nowrap">Major market event</span>
        </div>
      </div>
      <div class="text-sm text-[#6B7280]">
        Starting: <span class="font-semibold text-[#1F2937]"><%= number_to_currency(@initial_amount, precision: 0) %></span>
        &middot;
        Withdrawal: <span class="font-semibold text-[#1F2937]"><%= @withdrawal_rate %>%</span>
        <% if @fee.positive? %>
          &middot;
          Fees: <span class="font-semibold text-[#1F2937]"><%= format_fee(@fee) %>%/yr</span>
        <% end %>
      </div>
    </div>

    <div class="relative w-full" style="height: 400px;">
      <canvas data-chart-target="canvas"></canvas>
    </div>
  </section>

  <nav aria-label="Other retirement start years" class="space-y-4">
    <% if @other_depleted_years.present? %>
      <p class="text-sm text-[#374151]">
        <span class="font-semibold">Other retirements that ran out of money:</span>
        <% @other_depleted_years.each_with_index do |year, index| %><%= ", " if index > 0 %><%= link_to year, year_detail_path(year, @scenario_params), class: "text-[#7C3AED] font-medium hover:underline" %><% end %>
      </p>
    <% end %>

    <div class="flex items-center justify-between gap-4 text-sm font-semibold">
      <% if @previous_year %>
        <%= link_to year_detail_path(@previous_year, @scenario_params), rel: "prev", class: "px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-[#1F2937] transition-colors" do %>
          &larr; Retiring in <%= @previous_year %>
        <% end %>
      <% else %>
        <span></span>
      <% end %>
      <% if @next_year %>
        <%= link_to year_detail_path(@next_year, @scenario_params), rel: "next", class: "px-4 py-2 rounded-lg bg-gray-100 hover:bg-gray-200 text-[#1F2937] transition-colors" do %>
          Retiring in <%= @next_year %> &rarr;
        <% end %>
      <% end %>
    </div>
  </nav>

  <section class="max-w-md">
    <button type="button"
            class="px-4 h-11 rounded-lg border border-[#7C3AED]/30 bg-[#7C3AED]/5 hover:bg-[#7C3AED]/10 text-[#7C3AED] text-sm font-semibold transition-colors flex items-center justify-center gap-2"
            title="Copies a ready-made prompt with this scenario, the data and the rules so your AI assistant can model a variation the site doesn't offer"
            aria-label="Copies a ready-made prompt with this scenario, the data and the rules so your AI assistant can model a variation the site doesn't offer"
            data-controller="agent-prompt"
            data-agent-prompt-initial-amount-value="<%= @initial_amount %>"
            data-agent-prompt-withdrawal-rate-value="<%= @withdrawal_rate %>"
            data-agent-prompt-fee-value="<%= @fee %>"
            data-agent-prompt-starting-year-value="<%= @starting_year %>"
            data-action="click->agent-prompt#copy">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.456 2.456L21.75 6l-1.035.259a3.375 3.375 0 00-2.456 2.456z"></path>
      </svg>
      <span data-agent-prompt-target="label">Customize this scenario with your AI</span>
    </button>
    <p class="mt-2 text-xs text-[#6B7280] leading-snug">Copies a prompt with this scenario, the data and the rules. Paste it into ChatGPT, Claude, etc. to model a variation we don't offer.</p>
  </section>
</main>
