<%= turbo_stream.replace "year_detail" do %>
  <section class="mt-8 bg-white rounded-xl border border-gray-200 shadow-sm p-6" data-controller="chart" data-chart-data-value="<%= @chart_data.to_json %>">
    <div class="flex items-center gap-3 mb-6">
      <h3 class="text-xl font-bold text-[#1F2937]">Portfolio Value: Started in <%= @starting_year %></h3>
    </div>

    <div class="flex justify-between items-center mb-4">
      <div class="flex gap-6">
        <div class="flex items-center gap-2">
          <div class="w-3 h-3 rounded-full bg-[#7C3AED]"></div>
          <span class="text-sm text-[#6B7280]">Portfolio Value</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-3 h-0.5 border-t-2 border-dashed border-red-500"></div>
          <span class="text-sm text-[#6B7280]">$0 Reference Line</span>
        </div>
      </div>
    </div>

    <div class="relative w-full" style="height: 350px;">
      <canvas data-chart-target="canvas"></canvas>
    </div>
  </section>
<% end %>
